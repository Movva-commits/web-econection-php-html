# ==========================================================================
# econection — .htaccess
# Compatible con Hostinger / Apache 2.4
# ==========================================================================

# Página de inicio por defecto
DirectoryIndex index.php index.html

# UTF-8 por defecto
AddDefaultCharset UTF-8

# Bloquear listado de directorios
Options -Indexes

# ---- URLs limpias --------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS — activo (SSL gratuito de Hostinger)
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # /index y /index.php siempre redirigen al raíz
    RewriteRule ^index(\.php)?/?$ / [R=301,L]

    # Quitar el .php de la URL: /about en lugar de /about.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L]

    # Si alguien visita /about.php redirigir a /about
    RewriteCond %{THE_REQUEST} \s/+([^\s]+)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Bloquear acceso directo a includes/
    RewriteRule ^includes/ - [F,L]
</IfModule>

# ---- Compresión GZIP -----------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Caché del navegador -------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/jpg                 "access plus 6 months"
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# ---- Seguridad básica ----------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    <FilesMatch "\.(?:jpg|jpeg|png|webp|svg|woff2?)$">
        Header set Cache-Control "public, max-age=15552000, immutable"
    </FilesMatch>
</IfModule>

# Páginas de error personalizadas (opcional — crea estos archivos si quieres usarlas)
# ErrorDocument 404 /404.php
# ErrorDocument 500 /index.php
